{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "server.ts",
    "app.ts",
    "api/**/*.ts",
    "routes/**/*.ts",
    "controllers/**/*.ts",
    "services/**/*.ts",
    "types/**/*.ts",
    "constants/**/*.ts",
    "config/**/*.ts",
    "middleware/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "ts-node": {
    "files": true
  }
}
